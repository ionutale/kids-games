{
	"name": "kids-games",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run tests/unit tests/behavioral",
		"test:e2e": "playwright test",
		"test:e2e:headed": "HEADED=true playwright test",
		"test:all": "vitest run tests/unit tests/behavioral && playwright test",
		"deploy": "pnpm dlx vercel@latest --prod --yes && node scripts/pin-brand-alias.mjs",
		"alias:brand": "node scripts/pin-brand-alias.mjs",
		"prepare": "svelte-kit sync || echo ''"
	},
	"devDependencies": {
		"@playwright/test": "^1.61.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@vite-pwa/sveltekit": "^2.0.1",
		"@vite-pwa/workbox-swkit": "^8.0.14",
		"magicast": "^0.5.5",
		"pixelmatch": "^7.2.0",
		"pngjs": "^7.0.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.5",
		"vite": "^8.3.6",
		"vite-plugin-pwa": "^1.3.0",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"@fontsource-variable/fredoka": "^5.3.0",
		"headbreaker": "^3.0.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
