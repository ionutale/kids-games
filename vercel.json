{
  "outputDirectory": "public",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "kids-games-lac.vercel.app" }],
      "destination": "https://kids-2-5.aiu-media.com/$1",
      "statusCode": 301
    }
  ],
  "rewrites": [
    { "source": "/((?!_app|icons|screenshots|favicon|robots|sw|workbox|manifest).*)", "destination": "/index.html" }
  ]
}
